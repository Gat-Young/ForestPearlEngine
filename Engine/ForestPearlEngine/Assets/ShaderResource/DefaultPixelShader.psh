// Pixel Light ?´ìš© Shader
// b2 : Light,  b3 : Material
#include "PixelLight.hlsli"

//Shadow ?´ìš©
#include "CascadeShadow.hlsli"

//?ìˆ˜ ë²„í¼
cbuffer ObejctConstBuffer : register(b0)
{
    matrix mWorld;
    matrix mInverseWorld;
    matrix mTranseposeWorld;
    matrix mInverseTranseposeWorld;
    
    matrix mView;
    matrix mInverseView;
    matrix mTranseposeView;
    matrix mInverseTranseposeView;
    
    matrix mProj;
    matrix mInverseProj;
    matrix mTranseposeProj;
    matrix mInverseTranseposeProj;
    
    matrix mWV;
    matrix mInverseWV;
    matrix mTranseposeWV;
    matrix mInverseTranseposeWV;
    
    matrix mWVP;
    matrix mInverseWVP;
    matrix mTranseposeWVP;
    matrix mInverseTranseposeWVP;
    
};

////////////////////////////////////////////////////////////////////////////// 
//
//! Pixel Shader Main : ?½ì? ?°ì´??ë©”ì¸ ?¨ìˆ˜.
//
////////////////////////////////////////////////////////////////////////////// 

//?ìŠ¤ì²?ê°ì²´ ë³€??: ?”ì§„?ì„œ ê³µê¸‰?? ?ˆì??¤í„° ì§ì ‘ ì§€?? (ê¸°ë³¸ê°’ì? t0)
Texture2D TexDiff : register(t0);

//?ìŠ¤ì²??ˆí”Œ??(ì§ì ‘ì§€??  ê¸°ë³¸ê°’ì? s0
SamplerState Smpler : register(s0);

float4 PS_Main(
                float4 pos  : SV_POSITION,  //[?…ë ¥] ?•ì ì¢Œí‘œ. Vertex Position(Model Space, 3D) 
                float4 col  : COLOR0,       //[?…ë ¥] ?•ì ?? Vertex Color : "Diffuse" 
                float4 posv : TEXCOORD1,    //[?…ë ¥] WordlView ë³€?˜ëœ pos
                float2 uv   : TEXCOORD0,    //[?…ë ¥] uv
                float4 T    : TEXCOORD2,    //[?…ë ¥] WVë³€?˜ëœ Tangent
                float4 N    : TEXCOORD3,    //[?…ë ¥] ?? „ì¹˜WV ë³€?˜ëœ normal
                bool IsFrontFace : SV_IsFrontFace   //CULLMODE None?¼ë•Œ ???·ë©´ ?ë‹¨
                ) : SV_TARGET
{    
    //?ìŠ¤ì²??˜í”Œë§?
    
    if (!IsFrontFace)
    {
        N = -N;
    }
    
        
    float4 DiffuseLit = 0;
    float4 SpecularLit = 0;
    float4 EmissiveLit = 0;
    float4 AmbientLit = 0;
    
    CalculateLight(posv, N, mView, mInverseView, DiffuseLit, SpecularLit, EmissiveLit, AmbientLit);
    
    float Shadow = CalculateShadow(mul(mInverseView, posv), posv.z, N.xyz);
    
    DiffuseLit = DiffuseLit * Shadow;
    SpecularLit = SpecularLit * Shadow;
    
    float4 tex = TexDiff.Sample(Smpler, uv);
    
    col = col * DiffuseLit * tex + SpecularLit + EmissiveLit + col * AmbientLit * DiffuseLit;
    
    col.a = tex.a;

    return col;
}

