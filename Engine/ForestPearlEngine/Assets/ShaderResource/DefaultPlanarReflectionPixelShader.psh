//Default Planar Reflection Pixel Shader 소스
//DefaultPlanarReflectionVertexShader가 계산한 ReflectionUV로 반사 RenderTarget을 샘플링해서 출력

//Shadow 운용 (이 평면 위에도 Cascade Shadow가 드리우도록)
#include "CascadeShadow.hlsli"

//////////////////////////////////////////////////////////////////////////////
//
//! Pixel Shader Main : 픽셀 데이터 메인 함수.
//
//////////////////////////////////////////////////////////////////////////////

//상수 버퍼 : CalculateShadow에 필요한 mInverseView 계산용
cbuffer ObejctConstBuffer : register(b0)
{
    matrix mWorld;
    matrix mInverseWorld;
    matrix mTranseposeWorld;
    matrix mInverseTranseposeWorld;

    matrix mView;
    matrix mInverseView;
    matrix mTranseposeView;
    matrix mInverseTranseposeView;

    matrix mProj;
    matrix mInverseProj;
    matrix mTranseposeProj;
    matrix mInverseTranseposeProj;

    matrix mWV;
    matrix mInverseWV;
    matrix mTranseposeWV;
    matrix mInverseTranseposeWV;

    matrix mWVP;
    matrix mInverseWVP;
    matrix mTranseposeWVP;
    matrix mInverseTranseposeWVP;

};

//반사 RenderTarget (직접지정). 기본값은 t0
Texture2D ReflectionTex : register(t0);

//텍스처 샘플러 (직접지정)  기본값은 s0
SamplerState Smpler : register(s0);

float4 PS_Main(
                float4 pos  : SV_POSITION,  //[입력] 정점좌표. Vertex Position(Model Space, 3D)
                float4 col  : COLOR0,       //[입력] 정점색
                float4 posv : TEXCOORD1,    //[입력] WordlView 변환된 pos
                float2 uv   : TEXCOORD0,    //[입력] uv
                float4 T    : TEXCOORD2,    //[입력] WV변환된 Tangent
                float4 N    : TEXCOORD3,    //[입력] 역전치WV 변환된 normal
                float4 ReflectionClip : TEXCOORD4,  //[입력] VS에서 계산된 반사 카메라 클립좌표 (w로 나누기용)
                bool IsFrontFace : SV_IsFrontFace   //CULLMODE None일때 앞 뒷면 판단
                ) : SV_TARGET
{
    //w로 나누는 것을 픽셀 단위로 수행해야 틀어짐 없이 올바르게 샘플링
    float2 NDC = ReflectionClip.xy / ReflectionClip.w;
    float2 ReflectionUV = float2(
        NDC.x * 0.5f + 0.5f,
        0.5f - NDC.y * 0.5f
    );

    float4 ReflectionColor = ReflectionTex.Sample(Smpler, ReflectionUV);

    //이 평면 위에도 Cascade Shadow를 적용 (반사 색상에 그림자 계수를 곱함)
    float Shadow = CalculateShadow(mul(mInverseView, posv), posv.z, N.xyz);
    ReflectionColor.rgb = ReflectionColor.rgb * Shadow;

    return ReflectionColor;
}
