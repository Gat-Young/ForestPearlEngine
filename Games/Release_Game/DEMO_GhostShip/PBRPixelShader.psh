//
// Pixel Shader 전역 데이터.
//

// 텍스처 객체 : 엔진에서 공급됨.(PBR 용)
Texture2D g_texBase : register(t0); //BaseColor (Albedo)
Texture2D g_texMetal : register(t1); //Metalic Map
Texture2D g_texRough : register(t2); //Roughness Map
Texture2D g_texNormal : register(t3); //Normal Map
Texture2D g_texAO : register(t4); //AO Map
TextureCube g_texEnv : register(t5); //Envmap (큐브)

//텍스처 샘플러 (직접지정)(기본값은 s0)
SamplerState smpAniso : register(s0);




////////////////////////////////////////////////////////////////////////////// 
//
// Pixel Shader Main : 픽셀 셰이더 메인 함수.
//
////////////////////////////////////////////////////////////////////////////// 


float4 PS_Main(
				float4 pos : SV_POSITION, //[입력] (보간된) 픽셀별 좌표. (Screen, 2D)
				//float4 diff : COLOR0,     //[입력] (보간된) 픽셀별 확산색. (Diffuse)
				//float4 spec : COLOR1,     //[입력] (보간된) 픽셀별 정반사색. ("Specular")
				float2 uv : TEXCOORD0, //[입력] 텍스처 좌표
				float3 uvw : TEXCOORD1, //[입력] (보간된) 텍스처 좌표 (큐브멥용, 3성분)
                float4 posv : TEXCOORD2, //[입력] (보간된) 픽셀별 정점 좌표 (View Space)
                float4 nrm : TEXCOORD3 //[입력] (보간된) 픽셀별 노멀 (Model Space)
				) : SV_TARGET //[출력] 색상.(필수), "렌더타겟" 으로 출력합니다.
{

    //-----------------
	// 텍스쳐 셈플링
    //-----------------
    //이번 데모는 Base + Metal + Rough + AO 적용.★ 
    float4 texBase = 1;
    float4 texMetal = 1;
    float4 texRough = 1;
    float4 texNormal  = 0;    
    float4 texAO = 1;
    float4 tex = 0;
    
    //if (g_Mtrl.bTexOn)
    {
            texBase = g_texBase.Sample(smpAniso, uv); //sRGB8_A8
            texMetal = g_texMetal.Sample(smpAniso, uv).r; //R8
            texRough = g_texRough.Sample(smpAniso, uv).r; //R8 
            texNormal = g_texNormal.Sample(smpAniso, uv);       //RGBA8
            texAO = g_texAO.Sample(smpAniso, uv).r; //R8
		
        //사용할 텍스처 혼합.
        tex = texBase * texMetal * texRough * texAO;
        
        if (!GetMapMode(METAL_))
            texMetal = 0; //metal 미사용에 의한 zero 출력 방지.
        
        /*//사용할 텍스처 혼합.
        if (GetMapMode(METAL_)) 
              tex = texBase * texMetal * texRough * texAO;             
        else  tex = texBase * texRough * texAO;              //metal 미사용에 의한 zero 출력 방지.
        */
    }
    


    //----------------
    // 조명 계산.
    //---------------- 
    //조명 계산 1 (Diffuse Lighting)
    float4 diff = { 0, 0, 0, 1 }; //기본값 처리.
    if (g_Lit.bDiffOn)
    {
        //diff = DiffLight(nrm, mNWV, mView);                                //레거시 Diffuse (Lambert) 처리.
        //diff = Diffuse_BRDF(nrm, mNWV, mView, texBase, texAO);             //Diffuse-BRDF 적용.    
        diff = Diffuse_BRDF(nrm, mWV, mView, texBase, texMetal, texAO); //Diffuse-BRDF 적용.(v2) ★
    }
    
        
    
    //조명 계산 2 (Specular Lighting) 
    float4 spec = 0;
    if (g_Lit.bSpecOn)
    {
        //spec = SpecLight(posv, nrm, mNWV, mView);                                     //레거시 Specular(BlinnPhong) 처리.
        //spec = Specular_PreBRDF(posv, nrm, mNWV, mView, texRough);                    //레거시 Specular+ 적용.(Specular BRDF 선행 연구)
        spec = Specular_PreBRDF(posv, nrm, mWV, mView, texBase, texMetal, texRough); //레거시 Specular+ 적용.(Specular BRDF 선행 연구)(v2) ★

    }
 

    //조명 꺼짐, 텍스처 사용시 예외처리.
    //if (!g_Lit.bDiffOn && g_Mtrl.bTexOn) diff = 1;
    

   	//-----------------
    // 텍스처 표시 선택 (디버깅, 데모 전용)
    //------------------
    float4 col = 1;
    
    //모든 조명이 꺼진경우, 텍스처 표시, (디버깅, 데모전용)
    if (!g_Lit.bDiffOn && !g_Lit.bSpecOn)
    {
        diff = tex;
        spec = 0;
    }


    //-------------
    // 조명 혼합.
    //-------------
    col = diff + spec;

     
    return col;
}



