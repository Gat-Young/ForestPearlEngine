//
// Water PixelShader
// Builds a flowing distortion from BumpMap, uses it to sample the PlanarReflection
// result (ReflectionTex), and blends that with WaterColor.

cbuffer WaterSettings : register(b3)
{
    float FlowOffset;
    float DistortionStrength;
    float Tiling;
    float ReflectionAmount;
    float4 WaterColor;
};

//Bump map (R channel = height) driving the flowing distortion
Texture2D BumpMap : register(t0);
//Reflection RenderTarget captured by FPPlanarReflectionComponent
Texture2D ReflectionTex : register(t1);

SamplerState BumpWrap : register(s0);
SamplerState ReflectionClamp : register(s1);

struct PSInput
{
    float4 pos : SV_POSITION;
    float2 uv : TEXCOORD0;
    float4 ReflectionClip : TEXCOORD4;
};

float4 PS_Main(PSInput input) : SV_TARGET
{
    float2 bumpUV = input.uv * Tiling + float2(FlowOffset, 0);

    uint width, height;
    BumpMap.GetDimensions(width, height);
    float2 texel = 1.0f / float2(width, height);

    float center = BumpMap.Sample(BumpWrap, bumpUV).r;
    float right = BumpMap.Sample(BumpWrap, bumpUV + float2(texel.x, 0)).r;
    float down = BumpMap.Sample(BumpWrap, bumpUV + float2(0, texel.y)).r;
    float2 offset = float2(right - center, down - center) * DistortionStrength;

    //Perform the w-divide per pixel (correct projection without stretching)
    float2 NDC = input.ReflectionClip.xy / input.ReflectionClip.w;
    float2 ReflectionUV = float2(NDC.x * 0.5f + 0.5f, 0.5f - NDC.y * 0.5f);

    float4 reflection = ReflectionTex.Sample(ReflectionClamp, ReflectionUV + offset);

    float3 surface = lerp(WaterColor.rgb, reflection.rgb, saturate(ReflectionAmount));
    return float4(surface, 1.0f);
}
