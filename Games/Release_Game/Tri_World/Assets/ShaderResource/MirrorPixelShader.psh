// Mirror Pixel Shader
// Samples the scene-capture RenderTarget and displays it on the mirror plane.

Texture2D MirrorTex : register(t0);
SamplerState Smpler : register(s0);

float4 PS_Main(
                float4 pos : SV_POSITION,
                float4 col : COLOR0,
                float4 posv : TEXCOORD1,
                float2 uv : TEXCOORD0,
                float4 T : TEXCOORD2,
                float4 N : TEXCOORD3,
                bool IsFrontFace : SV_IsFrontFace
                ) : SV_TARGET
{
    return MirrorTex.Sample(Smpler, uv);
    //return MirrorTex.Sample(Smpler, uv) + float4(1.0f, 0.0f, 1.0f, 1.0f);
    
}
