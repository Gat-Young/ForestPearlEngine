cbuffer WaterSettings : register(b3)
{
    float FlowOffset;
    float DistortionStrength;
    float Tiling;
    float ReflectionAmount;
    float4 WaterColor;
    float EnvironmentAmount;
    float EnvironmentDistortionScale;
};

// Same bindings as the engine's existing PixelLight.hlsli and SkyLight render data.
cbuffer SkyLightConstantBuffer : register(b1)
{
    float4 LightColor;
    float LightIntensity;
};
TextureCube EnvTex : register(t127);
SamplerState EnvSampler : register(s15);

Texture2D BumpMap : register(t0);        // One height map; R channel is linear data.
Texture2D ReflectionMap : register(t1);  // Existing SceneCaptureRenderPass output. 다른 렌더타겟에 그려둔 반전세계 텍스쳐
SamplerState BumpWrap : register(s0);
SamplerState ReflectionClamp : register(s1);

struct PSInput
{
    float4 position : SV_POSITION;
    float2 uv : TEXCOORD0;
    float4 projected : TEXCOORD1;
    float3 toEye : TEXCOORD2;
};

float4 PS_Main(PSInput input) : SV_TARGET
{
    float2 bumpUV = input.uv * Tiling + float2(FlowOffset, 0);
    uint width, height;
    BumpMap.GetDimensions(width, height);
    float2 texel = 1.0 / float2(width, height);
    float center = BumpMap.Sample(BumpWrap, bumpUV).r;
    float right = BumpMap.Sample(BumpWrap, bumpUV + float2(texel.x, 0)).r;
    float down = BumpMap.Sample(BumpWrap, bumpUV + float2(0, texel.y)).r;
    float2 offset = float2(right - center, down - center) * DistortionStrength;
    float2 reflectionUV = input.projected.xy / input.projected.w * float2(0.5, -0.5) + 0.5;
    float4 reflection = ReflectionMap.Sample(ReflectionClamp, reflectionUV + offset);
    // Plane UV U points along +X and V along -Z. Reuse the single height-map gradient
    // to tilt the upward normal, then distort the cubemap sampling direction.
    float3 normal = normalize(float3(-offset.x * EnvironmentDistortionScale,
        1, offset.y * EnvironmentDistortionScale));
    float3 environmentDirection = reflect(-normalize(input.toEye), normal);
    float3 environment = EnvTex.Sample(EnvSampler, environmentDirection).rgb;
    float3 surface = WaterColor.rgb + environment * LightColor.rgb * LightIntensity * EnvironmentAmount;
    return float4(lerp(surface, reflection.rgb, saturate(reflection.a * ReflectionAmount)), 1);
}
